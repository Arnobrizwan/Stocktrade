# Copy this file to .env and fill in your own values.
# Never commit real secrets to the repository.

# Postgres connection string (e.g. Neon)
DATABASE_URL=

# Financial Modeling Prep API key (https://site.financialmodelingprep.com/developer/docs)
# Optional: if unset, the FMP data provider is skipped.
FMP_API_KEY=

# RapidAPI key for market data providers
RAPIDAPI_KEY=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
